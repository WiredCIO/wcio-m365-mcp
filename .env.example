# ============================================================================
# Wired CIO Microsoft 365 MCP — environment variables
# ============================================================================
# Copy this file to .env.local for local development.
# Set the same values in Vercel Project Settings → Environment Variables for prod.

# ----------------------------------------------------------------------------
# Entra ID app registration
# ----------------------------------------------------------------------------
# Found in Azure Portal → Entra ID → App registrations → [your app] → Overview
#
# Tenant ID — your Microsoft 365 tenant directory ID. Single-tenant means only
# users from this tenant can authenticate.
WCIO_MCP_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID — the Entra app's public ID.
WCIO_MCP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ----------------------------------------------------------------------------
# Public URLs
# ----------------------------------------------------------------------------
# The fully-qualified base URL where this MCP server is reachable.
# Vercel defaults look like https://wcio-m365-mcp.vercel.app
# Custom domain example: https://mcp.wiredcio.com
WCIO_MCP_BASE_URL=https://wcio-m365-mcp.vercel.app

# ----------------------------------------------------------------------------
# Optional: logging / observability
# ----------------------------------------------------------------------------
# Set to "1" to log every tool call (user oid, tool, target, outcome).
# Tokens are never logged regardless of this setting.
WCIO_MCP_VERBOSE_LOGGING=0
