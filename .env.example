# ============================================================================
# Wired CIO Microsoft 365 MCP — environment variables
# ============================================================================
# Copy this file to .env.local for local development.
# Set the same values in Vercel Project Settings → Environment Variables for prod.

# ----------------------------------------------------------------------------
# Entra ID app registration
# ----------------------------------------------------------------------------
# Found in Azure Portal → Entra ID → App registrations → [your app] → Overview
#
# Tenant ID — your Microsoft 365 tenant directory ID. Single-tenant means only
# users from this tenant can authenticate.
WCIO_MCP_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID — the Entra app's public ID.
WCIO_MCP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client secret — required: this server is a confidential OAuth client that
# performs the authorization-code and refresh-token exchanges with Entra
# server-side. Created in Entra → App registration → Certificates & secrets →
# New client secret. Copy the VALUE (not the Secret ID). 24-month expiry
# recommended. Treat as sensitive — never commit it. Set in Vercel env vars.
WCIO_MCP_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Public URLs
# ----------------------------------------------------------------------------
# The fully-qualified base URL where this MCP server is reachable.
# Vercel defaults look like https://wcio-m365-mcp.vercel.app
# Custom domain example: https://mcp.wiredcio.com
# The Entra redirect URI is derived as <base>/api/oauth/callback — register
# that exact value in the app registration's Authentication blade.
WCIO_MCP_BASE_URL=https://wcio-m365-mcp.vercel.app

# ----------------------------------------------------------------------------
# Token encryption
# ----------------------------------------------------------------------------
# 32-byte key (base64) used to encrypt Entra refresh tokens at rest in Redis.
# Generate with:  openssl rand -base64 32
# Rotating this key invalidates all existing sessions (users must re-auth).
WCIO_MCP_TOKEN_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Redis (OAuth state, sessions, tokens)
# ----------------------------------------------------------------------------
# Provision via Vercel → Storage → add a Redis (Upstash) integration. It injects
# KV_REST_API_URL / KV_REST_API_TOKEN (or UPSTASH_REDIS_REST_URL / _TOKEN)
# automatically in the deployment — you normally don't set these by hand.
# For local dev, run `vercel env pull` to populate .env.local.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ----------------------------------------------------------------------------
# Optional: logging / observability
# ----------------------------------------------------------------------------
# Set to "1" to log every tool call (user oid, tool, target, outcome).
# Tokens are never logged regardless of this setting.
WCIO_MCP_VERBOSE_LOGGING=0
